{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "依存の更新の PR を作る。公開から1日たった版だけ（pnpm-workspace.yaml の minimumReleaseAge と合わせる）。自動マージはしない",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":pinAllExceptPeerDependencies", ":semanticCommitsDisabled"],
  "minimumReleaseAge": "1 day",
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["依存の更新"],
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "フォントはまとめて更新する（画面写真の基準を作り直すことがある）",
      "matchPackageNames": ["@fontsource/**", "dejavu-fonts-ttf"],
      "groupName": "テスト用のフォント"
    },
    {
      "description": "Playwright は、クラウド環境の Chromium（/opt/pw-browsers）と版を合わせているので、自動では上げない",
      "matchPackageNames": ["playwright"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "three.js は r147 に固定（上げると見た目が変わる。別の作業として行う）",
      "matchPackageNames": ["three"],
      "enabled": false
    },
    {
      "description": "GitHub Actions はまとめて更新する（コミットのハッシュで固定）",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
