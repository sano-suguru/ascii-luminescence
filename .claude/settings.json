{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node --check *)",
      "Bash(node tools/*)",
      "Bash(node tests/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git push)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm fmt)",
      "Bash(pnpm fmt:check)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm build:test)",
      "Bash(pnpm where *)",
      "Bash(pnpm map *)",
      "Bash(pnpm map)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec oxfmt *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm verify)",
      "Bash(pnpm serve)"
    ],
    "ask": [
      "Bash(npx wrangler *)",
      "Bash(npx wrangler@4 *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(pnpm deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(pnpm add *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm install)",
      "Bash(pnpm approve-builds*)",
      "Bash(pnpm dlx *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force-with-lease*)",
      "Edit(/dist/**)",
      "Edit(/.build/**)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/.dev.vars)",
      "Read(/.dev.vars.*)",
      "Bash(git push * +*)",
      "Bash(git push origin --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push --mirror *)",
      "Edit(/pnpm-lock.yaml)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm add *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
