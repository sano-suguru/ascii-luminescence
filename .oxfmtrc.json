{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "singleQuote": true,
  // ゲーム本体の古い JS（src/game/）は、まとめては整形しない（行が約4倍に増えて読みにくくなるため）。TypeScript に移した物（src/lib/）から整形する。文書と生成物も整形しない
  "ignorePatterns": [
    "src/game/**",
    "src/index.html",
    "**/*.md",
    "dist/**",
    ".build/**",
    "tests/out/**",
    "tests/baseline/**",
    "pnpm-lock.yaml"
  ]
}
