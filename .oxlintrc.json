{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // エラー＝不具合（hook と CI を止める）、警告＝整理の候補。
  "env": { "es2024": true },
  "categories": { "correctness": "error" },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "caughtErrors": "none", "args": "none" }],
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    // ESLint の recommended にあって、Oxlint の correctness に入っていない規則を足す。
    // 特に no-redeclare：src/game/ は31ファイルを1つにつなぐので、別のファイルの同じ名前の関数が、黙って前のものを上書きしてしまう
    "no-redeclare": "error",
    // import した名前への代入（correctness に入っているが、はっきり書いておく）。src/game/imports.mjs で読んだ名前（TypeScript に移した物）に
    // 古い JS で代入すると、その行が動いた時に初めてブラウザで止まるので、lint で止める
    "no-import-assign": "error",
    "no-fallthrough": "error",
    "no-case-declarations": "error",
    "no-prototype-builtins": "error",
    "no-unused-labels": "error",
    "no-regex-spaces": "error",
    "no-empty-static-block": "error",
    "no-extra-boolean-cast": "error",
    "no-useless-escape": "error",
    "no-cond-assign": "error",
    "no-shadow-restricted-names": "error",
    "no-delete-var": "error",
    "no-global-assign": "error",
    "no-with": "error",
    "no-unsafe-optional-chaining": "error",
    "no-self-assign": "error",
    "no-sparse-arrays": "error",
    "no-unexpected-multiline": "error",
    "no-useless-catch": "error",
    "no-dupe-else-if": "error",
    "no-empty-pattern": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-useless-backreference": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "getter-return": "error",
    "no-inner-declarations": "error"
  },
  "overrides": [
    {
      // TypeScript に移した物（src/lib/）とその単体テスト。名前が定義されているかは tsc が確かめる
      "files": ["**/*.ts"],
      "rules": {
        "no-undef": "off",
        // 型の言い切り（as・後ろの !）は、tsc に「確かめずに信じろ」と言う書き方。間違っていても黙って通り、型を付けた意味が薄れる。
        // 配列や表を読む所は src/lib/array.ts の at・get（無ければその場で止まる）、範囲の外をわざと読む所は無い時の扱いをはっきり書く。
        // 要らない as（型が変わらない物）と、! はエラー。オブジェクトを作る所の { … } as 型 もエラー（欄をそろえて作る）
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/consistent-type-assertions": ["error", { "assertionStyle": "as", "objectLiteralTypeAssertions": "never" }]
      }
    },
    {
      // 道具・テスト・hooks（Node の ESM）
      "files": ["tools/**", "tests/**", ".claude/hooks/**", "*.config.mjs"],
      "env": { "node": true }
    },
    {
      // テストの page.evaluate の中はブラウザで動く
      "files": ["tests/**"],
      "env": { "browser": true },
      "globals": { "dbg": "readonly", "__test": "readonly" }
    },
    {
      // ゲーム本体：src/game/*.js をつないだもの（tools/lint-game.mjs が書き出して調べる）。
      // ブラウザの普通の <script>。THREE は CDN の <script> から来る。
      "files": [".build/lint/*.js"],
      "env": { "browser": true },
      "globals": { "THREE": "readonly" },
      "rules": {
        // 同じスコープで、宣言より前に let/const を使う（TDZ）のを見つける。関数の中から外の変数を読むのは許す
        "no-use-before-define": ["error", { "functions": false, "classes": true, "variables": false }],
        // 以下は不具合ではない書き方（調整用の *0.0、a&&a()、if(false) で止めたコード、好みの書き方）。整理の候補として警告にする
        "oxc/erasing-op": "warn",
        "no-unused-expressions": "warn",
        "no-constant-condition": "warn",
        "unicorn/no-useless-spread": "warn",
        "unicorn/prefer-string-starts-ends-with": "warn",
        "unicorn/prefer-set-size": "warn"
      }
    }
  ]
}
