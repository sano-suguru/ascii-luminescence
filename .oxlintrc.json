{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // エラー＝不具合（hook と CI を止める）、警告＝整理の候補。
  "env": { "es2024": true },
  "categories": { "correctness": "error" },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "caughtErrors": "none", "args": "none" }],
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    // ESLint の recommended にあって、Oxlint の correctness に入っていない規則を足す。
    "no-redeclare": "error",
    // import した名前への代入（correctness に入っているが、はっきり書いておく。その行が動いた時に初めて止まるので、lint で止める）
    "no-import-assign": "error",
    "no-fallthrough": "error",
    "no-case-declarations": "error",
    "no-prototype-builtins": "error",
    "no-unused-labels": "error",
    "no-regex-spaces": "error",
    "no-empty-static-block": "error",
    "no-extra-boolean-cast": "error",
    "no-useless-escape": "error",
    "no-cond-assign": "error",
    "no-shadow-restricted-names": "error",
    "no-delete-var": "error",
    "no-global-assign": "error",
    "no-with": "error",
    "no-unsafe-optional-chaining": "error",
    "no-self-assign": "error",
    "no-sparse-arrays": "error",
    "no-unexpected-multiline": "error",
    "no-useless-catch": "error",
    "no-dupe-else-if": "error",
    "no-empty-pattern": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-useless-backreference": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "getter-return": "error",
    "no-inner-declarations": "error"
  },
  "overrides": [
    {
      // ゲーム（src/lib/）とその単体テスト。名前が定義されているかは tsc が確かめる
      "files": ["**/*.ts", "**/*.d.mts"],
      "rules": {
        "no-undef": "off",
        // 使っていない変数・引数・import は、tsc（noUnusedLocals・noUnusedParameters）がエラーにする。oxlint の規則は、
        // 関数に覚えさせる欄の型（declare namespace の中の let）を使っていないと取り違えるので、.ts では使わない
        "no-unused-vars": "off",
        // 型の言い切り（as・後ろの !）は、tsc に「確かめずに信じろ」と言う書き方。間違っていても黙って通り、型を付けた意味が薄れる。
        // 配列や表を読む所は src/lib/array.ts の nth・lookup・must（無ければその場で止まる）、範囲の外をわざと読む所は無い時の扱いをはっきり書く。
        // as（as const は除く）と ! は、どれもエラー。どうしても要る所だけ、oxlint-disable-next-line と理由を書く
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }]
      }
    },
    {
      // ページの入口。ブラウザで動く
      "files": ["src/main.js"],
      "env": { "browser": true }
    },
    {
      // 道具・テスト・hooks（Node の ESM）
      "files": ["tools/**", "tests/**", ".claude/hooks/**", "*.config.mjs"],
      "env": { "node": true }
    },
    {
      // テストの page.evaluate の中はブラウザで動く
      "files": ["tests/**"],
      "env": { "browser": true },
      "globals": { "dbg": "readonly", "__test": "readonly" }
    },
    {
      // テストのページを使う道具：page.evaluate の中で __test を使う（ファイルは Node で動くので、ブラウザの名前は許さない）
      "files": ["tools/shots.mjs"],
      "globals": { "__test": "readonly" }
    },
    {
      // 主を本当にいる場所で写す道具・手触りの試し打ち：page.evaluate の中で __test と dbg を使う
      "files": ["tools/lords.mjs", "tools/feel.mjs", "tools/field.mjs", "tools/glare.mjs"],
      "globals": { "__test": "readonly", "dbg": "readonly" }
    },
    {
      // 場面が切り替わる時の確かめとタイトルを写す道具：テスト用モードでないページの page.evaluate の中で、dbg と画面の部品（document・window）を使う
      "files": ["tools/transitions.mjs", "tools/title-shots.mjs"],
      "globals": { "dbg": "readonly", "document": "readonly", "window": "readonly" }
    },
    {
      // 自動で試す台本をこの環境で流す道具：ページに差し込む見かけの時計（addInitScript）と page.evaluate の中で、ブラウザの名前を使う
      "files": ["tools/auto-run.mjs"],
      "globals": { "document": "readonly", "window": "readonly", "requestAnimationFrame": "readonly" }
    }
  ]
}
