// Cloudflare Workers（静的アセットのみ）。dist/ は pnpm build で作る（git には入れない）。
// Workers Builds の設定：Build command = pnpm build、Deploy command = npx wrangler deploy
// pnpm の版は package.json の packageManager（Corepack）、Node の版は .node-version で決まる。
// Workers Builds の資料に Node 26 の記載が無い。組み立てに失敗したら、Workers Builds の変数で NODE_VERSION=24 にする（組み立ては Node 22 以上で動く）
{
  "name": "ascii-luminescence",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
  },
}
